
{
    "manifest_version": 3,
    "name": "ApiForge",
    "version": "0.0.1",
    "description": "Intercept and override API calls.",

    "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse"
]   ,

    "host_permissions": [
        "<all_urls>"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "background": {
        "scripts": ["background.js"]
    },

    "content_scripts": [
        {
            "matches": ["https://tbcpl.lol/*"],
            "js": ["interceptor.js"],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],

    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
